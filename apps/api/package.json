{
  "name": "@commerce/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "admin:promote": "tsx src/cli/promote-admin.ts",
    "test:auth": "node --test test/auth.e2e.mjs",
    "test:catalog": "node --test test/catalog.e2e.mjs",
    "test:images": "node --test test/product-images.e2e.mjs",
    "test:cart": "node --test test/cart.e2e.mjs",
    "test:checkout": "node --test test/checkout.e2e.mjs",
    "test:payments": "node --test test/payments.e2e.mjs",
    "test:customers": "node --test test/customer-management.e2e.mjs",
    "test:admin-orders": "node --test test/admin-orders.e2e.mjs",
    "test:invalid-uuid": "node --test test/invalid-uuid.e2e.mjs",
    "test:fulfillment": "node --test test/fulfillment.e2e.mjs",
    "test:financial": "node --test test/financial.e2e.mjs",
    "test:hardening": "node --test test/hardening.unit.mjs"
  },
  "dependencies": {
    "@imagekit/nodejs": "latest",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/throttler": "latest",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "cookie-parser": "latest",
    "helmet": "latest",
    "pg": "latest",
    "razorpay": "^2.9.8",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "latest",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "dotenv": "latest",
    "eslint": "^9.39.2",
    "globals": "latest",
    "prisma": "^7.0.0",
    "tsx": "latest",
    "typescript": "^6.0.2",
    "typescript-eslint": "latest"
  }
}
